---
// Choose settings, drop an EPUB, see the book on the chosen reader, download.
// Conversion runs in the browser; nothing is uploaded.
import Device from "./Device.astro";
const lengths = [4, 6, 8, 10];
const speeds: [string, number][] = [["Average, fiction", 260], ["Average, non-fiction", 238], ["Unhurried", 200], ["Quick", 300]];
---
<div class="cv" data-cv>
  <div class="cv-settings">
    <div class="cv-group">
      <span class="cv-label" id="cv-len">Session length</span>
      <div class="cv-seg" role="radiogroup" aria-labelledby="cv-len">
        {lengths.map((m) => (
          <button type="button" role="radio" aria-checked={m === 6 ? "true" : "false"} data-min={m}>{m} min</button>
        ))}
      </div>
    </div>
    <div class="cv-group">
      <span class="cv-label" id="cv-speed">Reading speed</span>
      <div class="cv-list" role="radiogroup" aria-labelledby="cv-speed">
        {speeds.map(([label, w]) => (
          <button type="button" role="radio" aria-checked={w === 260 ? "true" : "false"} data-wpm={w}>
            <span>{label}</span><span class="mono">{w} wpm</span>
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="cv-main">
    <div class="cv-msg" data-msg role="alert" hidden>
      <strong data-msg-title></strong>
      <span data-msg-text></span>
    </div>

    <label class="cv-drop" data-drop>
      <input type="file" accept=".epub,application/epub+zip" class="visually-hidden" data-file />
      <span class="cv-drop-main"><span class="u">Choose an EPUB</span>, or drop it here.</span>
      <span class="cv-drop-sub" data-drop-sub>Your book is converted on this device and never uploaded.</span>
    </label>

    <div class="cv-result" data-result hidden>
      <div class="cv-preview">
        <Device live model="X4" id="cv-device" />
        <div class="cv-nav">
          <button type="button" class="cv-arrow" aria-label="Previous page" data-prev>&larr;</button>
          <span class="mono soft" data-page-label aria-live="polite"></span>
          <button type="button" class="cv-arrow" aria-label="Next page" data-next>&rarr;</button>
        </div>
      </div>
      <div class="cv-info">
        <div>
          <h3 data-title></h3>
          <span class="soft cv-author" data-author></span>
        </div>
        <p class="cv-summary" data-summary></p>
        <span class="mono soft" data-device-note></span>
        <p class="cv-warn" data-warn hidden></p>
        <div class="cv-actions">
          <a class="btn" data-download download>Download the Pocket Pages edition</a>
          <button type="button" class="textlink" data-again>Convert another book</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { convert } from "../lib/pocketpages.js";
  import { MODELS } from "../lib/device.js";

  const root = document.querySelector<HTMLElement>("[data-cv]")!;
  const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const input = q<HTMLInputElement>("[data-file]");
  const drop = q<HTMLLabelElement>("[data-drop]");
  const dropSub = q("[data-drop-sub]");
  const msg = q("[data-msg]");
  const result = q("[data-result]");
  const deviceEl = root.querySelector<HTMLElement>("#cv-device")!;
  let minutes = 6, wpm = 260, model: "X3" | "X4" = "X4", url: string | null = null;
  let pages: any[] = [], page = 0;

  // settings: radio groups with arrow-key support
  function radios(sel: string, pick: (b: HTMLButtonElement) => void) {
    const bs = [...root.querySelectorAll<HTMLButtonElement>(sel)];
    const set = (b: HTMLButtonElement) => { bs.forEach((x) => x.setAttribute("aria-checked", String(x === b))); pick(b); };
    bs.forEach((b, i) => {
      b.tabIndex = b.getAttribute("aria-checked") === "true" ? 0 : -1;
      b.addEventListener("click", () => { set(b); bs.forEach((x) => (x.tabIndex = x === b ? 0 : -1)); });
      b.addEventListener("keydown", (e) => {
        const d = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        const n = bs[(i + d + bs.length) % bs.length];
        n.click(); n.focus();
      });
    });
  }
  radios("[data-min]", (b) => (minutes = Number(b.dataset.min)));
  radios("[data-wpm]", (b) => (wpm = Number(b.dataset.wpm)));

  const MESSAGES: Record<string, [string, string]> = {
    notepub: ["That file isn't an EPUB.", "Pocket Pages works with .epub files. If you have the book in another format, Calibre can convert it first."],
    unreadable: ["This EPUB couldn't be read.", "The file may be damaged or incomplete. Try downloading it again, then choose it here."],
    drm: ["This book is DRM-locked.", "Locked books can't be converted. Try a DRM-free edition, or start with one of the free classics."],
  };
  function showMessage(code: string | null) {
    if (!code) { msg.hidden = true; return; }
    const [t, s] = MESSAGES[code] ?? MESSAGES.unreadable;
    q("[data-msg-title]").textContent = t;
    q("[data-msg-text]").textContent = s;
    msg.hidden = false;
  }

  const pageLabel = () => `${pages[page].kind === "open" ? "Start" : "End"} of pocket ${Math.floor(page / 2) + 1}`;
  function showPage(turn: boolean) {
    const pp = (deviceEl as any).pp;
    pp?.setCard(pages[page], turn);
    q("[data-page-label]").textContent = pageLabel();
    q<HTMLButtonElement>("[data-prev]").disabled = page === 0;
    q<HTMLButtonElement>("[data-next]").disabled = page === pages.length - 1;
  }
  q("[data-prev]").addEventListener("click", () => { if (page > 0) { page--; showPage(true); } });
  q("[data-next]").addEventListener("click", () => { if (page < pages.length - 1) { page++; showPage(true); } });

  function setModel(m: "X3" | "X4") {
    model = m;
    q("[data-device-note]").textContent = MODELS[m].note;
  }
  document.addEventListener("pp:model", (e) => setModel((e as CustomEvent).detail));

  const fileName = (t: string) => (t.replace(/[^\p{L}\p{N}]+/gu, " ").trim().replace(/\s+/g, "-") || "book") + "-pocket-pages.epub";

  async function run(file: File) {
    showMessage(null);
    if (!/\.epub$/i.test(file.name) && file.type !== "application/epub+zip") { showMessage("notepub"); return; }
    root.classList.add("busy");
    dropSub.textContent = `Converting ${file.name}…`;
    await new Promise((r) => setTimeout(r, 30));
    try {
      const { epub, stats } = await convert(await file.arrayBuffer(), { minutes, wpm });
      if (url) URL.revokeObjectURL(url);
      url = URL.createObjectURL(new Blob([epub], { type: "application/epub+zip" }));
      const a = q<HTMLAnchorElement>("[data-download]");
      a.href = url; a.download = fileName(stats.title);
      q("[data-title]").textContent = stats.title;
      q("[data-author]").textContent = stats.author || "";
      q("[data-summary]").textContent = `${stats.pockets} pockets of about ${minutes} minutes, about ${stats.weeks} week${stats.weeks === 1 ? "" : "s"} at one a day.`;
      const warn = q("[data-warn]");
      warn.hidden = stats.complete;
      warn.textContent = stats.complete ? "" : `Only ${stats.keptWords.toLocaleString("en-IE")} of ${stats.sourceWords.toLocaleString("en-IE")} words were placed. Look through the book before relying on it.`;
      setModel(model);
      pages = stats.preview; page = 0;
      drop.hidden = true;
      result.hidden = false;
      showPage(false);
      result.scrollIntoView({ block: "nearest", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
      a.focus({ preventScroll: true });
    } catch (err: any) {
      showMessage(err?.code === "drm" ? "drm" : "unreadable");
    } finally {
      root.classList.remove("busy");
      dropSub.textContent = "Your book is converted on this device and never uploaded.";
      input.value = "";
    }
  }

  input.addEventListener("change", () => { if (input.files?.[0]) run(input.files[0]); });
  for (const ev of ["dragenter", "dragover"]) drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.add("over"); });
  for (const ev of ["dragleave", "drop"]) drop.addEventListener(ev, () => drop.classList.remove("over"));
  drop.addEventListener("drop", (e) => { e.preventDefault(); const f = (e as DragEvent).dataTransfer?.files?.[0]; if (f) run(f); });
  q("[data-again]").addEventListener("click", () => { result.hidden = true; drop.hidden = false; showMessage(null); input.click(); });
</script>

<style>
  .cv {
    background: var(--pr); border: 1px solid var(--fr);
    padding: clamp(20px, 3vw, 44px);
    display: flex; flex-wrap: wrap; gap: clamp(28px, 4vw, 56px);
  }
  .cv-settings { flex: 1 1 260px; max-width: 340px; display: flex; flex-direction: column; gap: 32px; }
  .cv-group { display: flex; flex-direction: column; gap: 12px; }
  .cv-label { font-size: 17px; font-weight: 600; }
  .cv-seg { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--ik); border: 1px solid var(--ik); }
  .cv-seg button {
    border: 0; padding: 11px 0; cursor: pointer; font-family: var(--mono); font-size: 13px;
    background: var(--pr); color: var(--ik);
  }
  .cv-list { display: flex; flex-direction: column; border-top: 1px solid var(--fr); }
  .cv-list button {
    display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
    border: 0; border-bottom: 1px solid var(--fr); padding: 10px 12px; cursor: pointer; text-align: left;
    font-family: var(--serif); font-size: 17px; background: var(--pr); color: var(--ik);
  }
  .cv-list .mono { white-space: nowrap; }
  .cv-seg button[aria-checked="true"], .cv-list button[aria-checked="true"],
  .cv-seg button:hover, .cv-list button:hover { background: var(--ik); color: var(--pa); }

  .cv-main { flex: 999 1 400px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .cv-msg {
    background: var(--pr); border: 1px solid var(--ik); padding: 24px;
    display: flex; flex-direction: column; gap: 10px; font-size: 18px; line-height: 1.55;
  }
  .cv-msg[hidden] { display: none; }
  .cv-msg strong { font-weight: 600; }
  .cv-drop {
    flex: 1; min-height: 320px; border: 1px dashed var(--gr); cursor: pointer;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px;
    padding: 32px 24px; text-align: center;
  }
  .cv-drop[hidden] { display: none; }
  .cv-drop:hover, .cv-drop.over { border-style: solid; }
  .cv-drop:focus-within { outline: 2px solid var(--ik); outline-offset: 3px; }
  :global(.busy) .cv-drop { opacity: 0.6; pointer-events: none; }
  .cv-drop-main { font-size: clamp(22px, 2.2vw, 28px); line-height: 1.3; text-wrap: balance; }
  .cv-drop-main .u { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .cv-drop-sub { font-size: 17px; line-height: 1.5; color: var(--gr); max-width: 32ch; }

  .cv-result { flex: 1; display: flex; flex-wrap: wrap; gap: clamp(28px, 3.5vw, 48px); align-items: flex-start; }
  .cv-result[hidden] { display: none; }
  .cv-preview { flex: 0 0 auto; width: 260px; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .cv-nav { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .cv-arrow {
    width: 44px; height: 44px; border: 1px solid var(--ik); background: transparent; color: var(--ik);
    font-family: var(--serif); font-size: 20px; cursor: pointer;
  }
  .cv-arrow:hover:not(:disabled) { background: var(--ik); color: var(--pa); }
  .cv-arrow:disabled { opacity: 0.35; cursor: default; }
  .cv-info { flex: 1 1 240px; min-width: 0; display: flex; flex-direction: column; gap: 16px; padding-top: 8px; }
  .cv-info h3 { font-size: clamp(36px, 3.4vw, 48px); line-height: 1.02; letter-spacing: -0.015em; }
  .cv-author { font-size: 18px; }
  .cv-summary { font-size: 19px; line-height: 1.55; max-width: 30ch; }
  .cv-warn { font-size: 17px; border-left: 2px solid var(--ik); padding-left: 12px; }
  .cv-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 12px; }
</style>
