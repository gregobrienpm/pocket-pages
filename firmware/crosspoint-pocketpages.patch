+
+// Headings imply bold through depth tracking. An explicit CSS or inline weight
+// (font-weight: normal or bold) is more specific and must win, as in browsers.
+namespace {
+EpdFontFamily::Style flushWordAndGetStyle(ChapterHtmlSlimParser& parser, const char* word) {
+  parser.currentTextBlock = std::make_unique<ParsedText>(false);
+  strcpy(parser.partWordBuffer, word);
+  parser.partWordBufferIndex = static_cast<int>(strlen(word));
+  parser.flushPartWordBuffer();
+  return parser.currentTextBlock->getWordStyleAt(0);
+}
+}  // namespace
+
+TEST_F(ChapterHtmlSlimParserTest, HeadingTextIsBoldByDefault) {
+  parser.depth = 2;
+  parser.boldUntilDepth = 1;  // inside <h3>
+  parser.inlineStyleStack.clear();
+  parser.currentCssStyle = CssStyle();
+  parser.updateEffectiveInlineStyle();
+  EXPECT_TRUE(flushWordAndGetStyle(parser, "Pocket") & EpdFontFamily::BOLD);
+}
+
+TEST_F(ChapterHtmlSlimParserTest, HeadingSpanWithNormalWeightRendersRegular) {
+  parser.depth = 3;
+  parser.boldUntilDepth = 1;  // inside <h3><span style="font-weight: normal">
+  parser.currentCssStyle = CssStyle();
+  parser.inlineStyleStack.clear();
+  ChapterHtmlSlimParser::StyleStackEntry span;
+  span.depth = 2;
+  span.hasBold = true;
+  span.bold = false;
+  parser.inlineStyleStack.push_back(span);
+  parser.updateEffectiveInlineStyle();
+  EXPECT_FALSE(flushWordAndGetStyle(parser, "read") & EpdFontFamily::BOLD);
+}
+
+TEST_F(ChapterHtmlSlimParserTest, BoldTagInsideNormalSpanStaysBold) {
+  parser.depth = 4;
+  parser.boldUntilDepth = 1;  // <h3><span style="font-weight: normal"><b>
+  parser.currentCssStyle = CssStyle();
+  parser.inlineStyleStack.clear();
+  ChapterHtmlSlimParser::StyleStackEntry span;
+  span.depth = 2;
+  span.hasBold = true;
+  span.bold = false;
+  ChapterHtmlSlimParser::StyleStackEntry bold;
+  bold.depth = 3;
+  bold.hasBold = true;
+  bold.bold = true;
+  parser.inlineStyleStack.push_back(span);
+  parser.inlineStyleStack.push_back(bold);
+  parser.updateEffectiveInlineStyle();
+  EXPECT_TRUE(flushWordAndGetStyle(parser, "strong") & EpdFontFamily::BOLD);
+}
